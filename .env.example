# Copy this file to .env and fill in real values. Never commit .env.

# Your WordPress site (no trailing slash)
WP_SITE_URL=https://timswebworx.co.za

# A WordPress user with edit_posts capability (your admin account is fine)
WP_USERNAME=your-wp-username

# An Application Password generated for that user in
# WP Admin -> Users -> Profile -> Application Passwords.
# Paste it exactly as WordPress shows it, spaces included.
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# The public hostname this server will be reached at
MCP_PUBLIC_HOST=mymcp.timswebworx.co.za

# A long random shared secret — the plugin's .mcp.json sends this as a
# bearer token. Generate one with: openssl rand -hex 32
MCP_BEARER_TOKEN=replace-with-a-long-random-string

# From Cloudflare Zero Trust -> Networks -> Tunnels -> (your tunnel) -> the
# install command it shows you. Just the token value, no "cloudflared ...".
CLOUDFLARE_TUNNEL_TOKEN=replace-with-your-tunnel-token
